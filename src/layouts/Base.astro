---
import "../styles/global.css";
import reglages from "../content/reglages.json";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Annonce from "../components/Annonce.astro";
import { ROUTES, t, type Lang, type RouteKey } from "../i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  routeKey?: RouteKey;
  image?: string;
  ogType?: string;
  jsonld?: object | object[];
  noindex?: boolean;
}
const { lang, title, routeKey, ogType = "website", jsonld, noindex = false } = Astro.props;
const description = Astro.props.description || t(reglages.site.description, lang);
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const image = new URL(Astro.props.image || reglages.site.image_partage, site).href;
const alternates = routeKey && ROUTES[routeKey].fr !== ROUTES[routeKey].en
  ? [
      { hreflang: "fr", href: new URL(ROUTES[routeKey].fr, site).href },
      { hreflang: "en", href: new URL(ROUTES[routeKey].en, site).href },
      { hreflang: "x-default", href: new URL(ROUTES[routeKey].fr, site).href },
    ]
  : [];
const plausible = reglages.statistiques.plausible_domaine;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Ismail Haiber">
  <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large"}>
  <link rel="canonical" href={canonical}>
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href}>)}
  <meta name="theme-color" content="#0b0718">
  <meta property="og:type" content={ogType}>
  <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"}>
  <meta property="og:site_name" content={reglages.site.nom}>
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={image}>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%230b0718'/%3E%3Cpath d='M9 7h14M9 25h14M16 7v18' stroke='%23ff3fa4' stroke-width='3'/%3E%3C/svg%3E">
  <link rel="apple-touch-icon" href="/photo.jpg">
  <link rel="sitemap" href="/sitemap-index.xml">
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tilt+Neon&family=Neonderthaw&family=Chakra+Petch:wght@400;500;600;700&family=Exo+2:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
  {plausible && <script is:inline defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>}
</head>
<body>
  <Annonce lang={lang} />
  <Header lang={lang} routeKey={routeKey} />
  <main id="contenu">
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
